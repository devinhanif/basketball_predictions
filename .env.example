# Copy to .env (gitignored) and fill in. Keys are read from the environment only, never from code
# or configs; run tools with `uv run --env-file .env ...`. Read-only data access; no trading keys.
ODDS_API_KEY=            # theoddsapi.com (live props benchmark; nba/odds)
THE_ODDS_API_KEY=        # the-odds-api.com (historical odds archive; probe + one-time pull)
X_BEARER_TOKEN=          # X API v2 app bearer token (beat-reporter feed, read-only; nba/ingest/reporters). chmod 600 .env
