<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  JARVIS watch job (docs/DAILY_PIPELINE.md, "JARVIS"). TEMPLATE: NOT loaded by anything in the repo; the maintainer installs it by hand.
  Paper-only, alert-only, read-only. One pass every 2 minutes: slate summary text at about T-90 to the first tip, an immediate text when a
  new strong or arbitrage play appears, closing-line quotes logged for the paper book. Idle (exits in seconds) when there is no game.

  The iMessage recipient is NOT in this file. It is the env var JARVIS_IMESSAGE_TO, copied into YOUR installed copy under
  ~/Library/LaunchAgents (outside the repo) by the install command. The placeholder below fails validation, so an uninstalled
  placeholder can never text anyone.

  install (zsh; type the number at the prompt, it is not echoed or saved in history):
    read -rs "JARVIS_IMESSAGE_TO?recipient (phone or Apple ID email): "; export JARVIS_IMESSAGE_TO; echo
    cp ops/launchd/local.nba.jarvis.plist ~/Library/LaunchAgents/ \
      && plutil -replace EnvironmentVariables.JARVIS_IMESSAGE_TO -string "$JARVIS_IMESSAGE_TO" ~/Library/LaunchAgents/local.nba.jarvis.plist \
      && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.nba.jarvis.plist
  first run by hand (triggers the macOS Messages permission prompt, once): uv run python -m nba.jarvis test-send
  uninstall: launchctl bootout gui/$(id -u)/local.nba.jarvis && rm ~/Library/LaunchAgents/local.nba.jarvis.plist

  Launched through uv, never /bin/sh: TCC blocks sh from reading ~/Downloads (exit 126 stopped every job once).
  Needs Ollama only for the one-sentence explanation (ollama serve; ollama pull qwen2.5:3b); without it texts use template sentences.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.nba.jarvis</string>
  <key>WorkingDirectory</key><string>/Users/devin/Downloads/nba-prediction</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>--no-sync</string>
    <string>python</string><string>-m</string><string>nba.jarvis</string><string>watch</string><string>--once</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_IMESSAGE_TO</key><string>REPLACE_ME_BY_THE_INSTALL_COMMAND</string>
    <key>HOME</key><string>/Users/devin</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/devin/Downloads/nba-prediction/data/ops/launchd_jarvis.out</string>
  <key>StandardErrorPath</key><string>/Users/devin/Downloads/nba-prediction/data/ops/launchd_jarvis.err</string>
</dict>
</plist>
