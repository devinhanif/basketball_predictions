<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pull orchestrator tick (docs/DESIGN_PULL_ORCHESTRATOR.md, P1). TEMPLATE: NOT loaded by anything in the repo; the maintainer installs it.
  Normally installed by ops/install_launchd.sh (which writes this same job). By hand:
    install:    cp ops/launchd/local.nba.pulls.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.nba.pulls.plist
    run now:    launchctl kickstart -k gui/$(id -u)/local.nba.pulls
    uninstall:  launchctl bootout gui/$(id -u)/local.nba.pulls && rm ~/Library/LaunchAgents/local.nba.pulls.plist
  Every 2 minutes it serves open pull requests (JARVIS files one when an alert's Pinnacle reference is stale) with one per-event
  Pinnacle pull each. Idle (no request) it exits in about a second with no network. OFF unless NBA_CLOSE_CAPTURE=1 (environment or a
  line in .env), the same gate as the scheduled capture. Read-only: public GETs only; THE_ODDS_API_KEY comes from .env through
  `uv run --env-file`, never from this file. Never writes nba.duckdb (read-only for schedule teams), no data/ops/lock, no heavy.lock. Own lock data/ops/pulls_lock, heartbeat
  data/ops/heartbeat/pulls.json, ALERTS.md lines tagged [pulls].
  Launched through uv (never /bin/sh directly: TCC blocks sh from reading ~/Downloads).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.nba.pulls</string>
  <key>WorkingDirectory</key><string>/Users/devin/Downloads/nba-prediction</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>--no-sync</string>
    <string>sh</string><string>/Users/devin/Downloads/nba-prediction/ops/nba_pulls.sh</string><string>pulls</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/devin/Downloads/nba-prediction/data/ops/launchd_pulls.out</string>
  <key>StandardErrorPath</key><string>/Users/devin/Downloads/nba-prediction/data/ops/launchd_pulls.err</string>
</dict>
</plist>
